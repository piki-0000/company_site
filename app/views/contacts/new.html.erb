<h1>お問い合わせ</h1>

<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<%= form_with model: @contact, url: contacts_path, local: true do |f| %>
  <% if @contact.errors.any? %>
    <ul>
      <% @contact.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name, "お名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :phone, "電話番号" %>
    <%= f.telephone_field :phone %>
  </div>

  <div>
    <%= f.label :company, "会社名" %>
    <%= f.text_field :company %>
  </div>

  <div>
    <%= f.label :message, "お問い合わせ内容" %>
    <%= f.text_area :message, rows: 8 %>
  </div>

  <%= f.submit "送信する" %>
<% end %>